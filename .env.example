# Server-side settings installed as /etc/claude-bridge/backend.env.
# SSH client settings are in desktop/.env.example instead.
BRIDGE_DB=/var/lib/claude-bridge/bridge.sqlite3
BRIDGE_ENABLE_MOCK=1
# Lists use comma-separated model IDs. Empty lists disable the provider.
ANTHROPIC_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
OPENAI_MODELS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS_FIELD=max_completion_tokens
OLLAMA_MODELS=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Budget for conversation + local context, measured in UTF-8 bytes.
BRIDGE_CONTEXT_BYTES=56000
BRIDGE_OUTPUT_TOKENS=4096
